# ─── MySQL (Local) ───────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=homeocare

# ─── JWT Auth ────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-very-long-random-secret-min-32-chars-please
JWT_EXPIRES_IN=30d

# ─── App ─────────────────────────────────────────────────────────
NODE_ENV=development
