# ─── MySQL Configuration (Local 8.x) ─────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=homeocare

# ─── JWT Authentication Secret ────────────────────────────────────
# Generate a strong 64-character random string for production deployment
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters
JWT_EXPIRES_IN=30d

# ─── Application Environment ──────────────────────────────────────
NODE_ENV=development
